# Copy to .env and fill in values
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_ISSUER=alix-vintage
JWT_AUDIENCE=alix-vintage-web
JWT_TTL_SECONDS=86400

# Admin bootstrap (required to register admins via API)
ADMIN_SETUP_KEY=change-me

# Admin login (used by /api/admin/login)
ADMIN_LOGIN_USERNAME=admin
ADMIN_LOGIN_PASSWORD=change-me

# Email verification (6-digit code)
# Default behavior in APP_ENV=local is to log emails to: server/storage/logs/mail.log
# Set MAIL_DRIVER=mail if you have PHP mail() configured.
# Or set MAIL_DRIVER=smtp to use SMTP (recommended for Gmail).
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=no-reply@localhost
MAIL_FROM_NAME="Alix Vintage"

# SMTP (for Gmail)
# For Gmail, use an App Password (Google account must have 2-Step Verification enabled)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=15

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=alix_vintage
DB_USER=postgres
DB_PASSWORD=postgres
